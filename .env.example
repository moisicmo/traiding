# Clave para firmar la sesión. Genérala con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=

# Login con Google (console.cloud.google.com → APIs y servicios → Credenciales → ID de cliente OAuth)
# URI de redirección autorizada: https://trading.luminia.com.bo/api/auth/callback/google
#                          y en local: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Solo estos correos pueden entrar (separados por coma)
ALLOWED_EMAILS=tu-correo@gmail.com

# Dirección pública de la app (en local: http://localhost:3000).
# Sin esto, detrás de Cloudflare el login redirige a la dirección interna del contenedor (0.0.0.0:4300)
AUTH_URL=https://trading.luminia.com.bo

# Necesario detrás de Cloudflare Tunnel
AUTH_TRUST_HOST=true

# Solo en desarrollo: true para saltar el login mientras no tengas las credenciales de Google
AUTH_DISABLED=false

# Notificaciones por Telegram: crea el bot con @BotFather. El chat id lo encuentras en la página /notificaciones
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Binance: API key de SOLO LECTURA (Perfil → Gestión de API). Nunca actives trading ni retiros.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# 💰 Bot real (pestaña Bot → Bot real): una llave APARTE, con permiso de operar Spot y SIN permiso de retiro.
# Para practicar: crea la llave en https://testnet.binance.vision (entras con GitHub) y deja BINANCE_TRADE_URL vacío.
# Para plata real (solo cuando lo decidas): BINANCE_TRADE_URL=https://api.binance.com y una llave de tu cuenta, restringida a la IP del NAS.
BINANCE_TRADE_API_KEY=
BINANCE_TRADE_API_SECRET=
# BINANCE_TRADE_URL=

# Dónde se guarda la base de datos SQLite (en Docker: /app/data, un volumen)
# DATA_DIR=./data

# P2P USDT/BOB: monto típico de tus operaciones en Bs (solo cuenta anuncios que acepten este monto)
# P2P_AMOUNT_BOB=1000
